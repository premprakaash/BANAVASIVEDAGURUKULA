# Live website settings — used by `npm run build` (the GitHub Actions deploy).
# These values are public (they end up in the website), so this file is committed.
# Do NOT put passwords or API keys here.

# Public address of the Cloudflare R2 bucket that serves the gallery.
# R2 → your bucket → Settings → Public Development URL (or your custom domain). No trailing slash.
VITE_MEDIA_BASE_URL=
